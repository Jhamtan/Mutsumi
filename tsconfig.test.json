{
  "extends": "./tsconfig.web.json",
  "include": [
    "vitest*.config.mts",
    "tests/unit/**/*.ts",
    "src/renderer/src/env.d.ts",
    "src/renderer/src/typings/**/*.d.ts",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strictNullChecks": true,
    "types": ["node", "vite/client"]
  }
}
